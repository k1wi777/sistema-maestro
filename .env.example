# Docker Compose variables (local development only). Copy to .env to override the defaults.
POSTGRES_USER=gns
POSTGRES_PASSWORD=gns
POSTGRES_DB=gns
POSTGRES_PORT=5432
MINIO_ROOT_USER=gns-minio
MINIO_ROOT_PASSWORD=gns-minio-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Los valores de MinIO de arriba también son las credenciales de almacenamiento locales de la
# API (STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY en apps/api/.env.example).
