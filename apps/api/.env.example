NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://gns:gns@localhost:5432/gns
# Primer administrador de los datos iniciales (db:seed). Sin valores por defecto.
SEED_ADMIN_NAME=Administrador GNS
SEED_ADMIN_EMAIL=administrador@gns.test
# Orígenes del frontend permitidos por CORS (separados por comas, sin barra final).
# Ajústalo al puerto del frontend (FE-01).
CORS_ORIGINS=http://localhost:3001
# Autenticación (BE-32). Los valores de abajo son SOLO para desarrollo local: genera
# secretos propios y distintos para cualquier otro entorno (p. ej. `openssl rand -base64 48`).
# Deben tener al menos 32 caracteres y ser distintos entre sí.
JWT_ACCESS_SECRET=solo-desarrollo-local-acceso-cambiar-fuera-de-local
REFRESH_TOKEN_SECRET=solo-desarrollo-local-renovacion-cambiar-fuera-de-local
# Plazos de la sesión (valores por defecto): vida del token de acceso en minutos, margen
# en segundos en que el token de renovación anterior aún vale (varias pestañas), horas de
# inactividad tras las que hay que ingresar de nuevo y días máximos con «mantener la sesión».
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_ROTATION_GRACE_SECONDS=30
SESSION_IDLE_TIMEOUT_HOURS=24
SESSION_REMEMBER_MAX_DAYS=7
# `false` solo para http://localhost; en producción debe ser `true` (la API no arranca si no).
AUTH_COOKIE_SECURE=false
# Intentos de ingreso permitidos por IP y correo en la ventana (segundos).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
# Versión vigente del aviso de tratamiento de datos (obligatoria, sin valor por defecto;
# hasta 20 caracteres: letras, números, punto, guion o guion bajo). Cambiarla y reiniciar
# la API obliga a todos los usuarios a aceptar el aviso de nuevo.
DATA_POLICY_VERSION=2026-1

# Almacenamiento de archivos (BE-76): MinIO local; en producción, Cloudflare R2
# (STORAGE_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com, STORAGE_FORCE_PATH_STYLE=false).
# Las credenciales de abajo son las de MinIO del docker-compose (solo desarrollo local).
# Crea el bucket una vez con `pnpm --filter @gns/api storage:init` (idempotente, tras `pnpm build`).
# Un bucket de R2 necesitará además una regla CORS que permita PUT/GET desde el origen del
# frontend (fuera de alcance de esta fase).
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=gns-files
STORAGE_ACCESS_KEY_ID=gns-minio
STORAGE_SECRET_ACCESS_KEY=gns-minio-secret
STORAGE_FORCE_PATH_STYLE=true
# Caducidad (segundos) de las URL firmadas de subida y descarga (60-3600) y de visualización
# de video, PDF e imágenes (600-21600, no menor que la anterior).
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_VIEW_URL_TTL_SECONDS=7200
