// Modelo de datos de la Plataforma GNS: 31 tablas en 7 módulos.
// Modelos y campos en inglés, mapeados a tablas y columnas en español (snake_case).
// Lo que Prisma no expresa (triggers de la bitácora, privilegios y CHECK) vive en
// las migraciones SQL escritas a mano.
//
// Convenciones del mapeo:
// - Los UUID los genera la base (gen_random_uuid()), no el cliente, para que los
//   seeds y el SQL directo también reciban id.
// - Las relaciones usan NoAction, como el modelo validado: borrar un padre
//   referenciado falla en lugar de propagar el borrado.
// - Los estados y tipos son varchar + CHECK (no enums) y sus valores viven en
//   @gns/shared.

// El cliente se genera dentro de src/ porque el generador emite TypeScript que
// se compila con la API. Es un artefacto (no se versiona): `pnpm db:generate`,
// que el postinstall del monorepo ejecuta y que no necesita base de datos.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Identidad y acceso ----------

model User {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName           String   @map("nombre_completo") @db.VarChar(120)
  institutionalEmail String   @unique @map("correo_institucional") @db.VarChar(160)
  role               String   @map("rol") @db.VarChar(20)
  status             String   @map("estado") @db.VarChar(10)
  createdById        String?  @map("creado_por") @db.Uuid
  createdAt          DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  createdBy                     User?                          @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdUsers                  User[]                         @relation("UserCreatedBy")
  dataConsents                  DataConsent[]
  teacherAssignments            TeacherAssignment[]
  coordinatedGrades             Grade[]
  lessonPlans                   LessonPlan[]
  reviews                       Review[]
  sharedActivities              SharedActivity[]
  favoriteActivities            FavoriteActivity[]
  fieldJournalArchives          FieldJournalArchive[]
  createdFieldJournals          FieldJournal[]                 @relation("FieldJournalCreatedBy")
  voidedFieldJournals           FieldJournal[]                 @relation("FieldJournalVoidedBy")
  fieldJournalAnnotations       FieldJournalAnnotation[]
  fieldJournalSubmissions       FieldJournalSubmission[]
  observerNotes                 ObserverNote[]
  moduleProgress                ModuleProgress[]
  activityProgress              ActivityProgress[]
  certificates                  Certificate[]
  uploadedFiles                 StoredFile[]
  updatedFaqEntries             FaqEntry[]
  closedUnansweredQuestions     UnansweredQuestion[]           @relation("UnansweredQuestionClosedBy")
  unansweredQuestionOccurrences UnansweredQuestionOccurrence[]
  auditLogs                     AuditLog[]
  passwordCredential            PasswordCredential?
  sessions                      Session[]

  @@index([createdById])
  @@map("usuario")
}

// Contraseña de un usuario como hash argon2id (formato PHC). Va en una tabla aparte para
// que el hash nunca viaje en las lecturas de `usuario`. La migración añade el CHECK
// `hash LIKE '$argon2id$%'`.
model PasswordCredential {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("usuario_id") @db.Uuid
  hash      String   @map("hash") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("credencial_contrasena")
}

// Sesión de un dispositivo. `generation` es la generación vigente del token de renovación;
// `expiresAt` es el máximo absoluto de «mantener la sesión iniciada» (nulo si no se marcó).
model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("usuario_id") @db.Uuid
  provider         String    @map("proveedor") @db.VarChar(20)
  generation       Int       @default(0) @map("generacion")
  rotatedAt        DateTime? @map("rotada_en") @db.Timestamptz(6)
  renewedAt        DateTime  @map("renovada_en") @db.Timestamptz(6)
  expiresAt        DateTime? @map("expira_en") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revocada_en") @db.Timestamptz(6)
  revocationReason String?   @map("motivo_revocacion") @db.VarChar(20)
  createdAt        DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@map("sesion")
}

model DataConsent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("usuario_id") @db.Uuid
  policyVersion String   @map("version_politica") @db.VarChar(20)
  acceptedAt    DateTime @map("aceptado_en") @db.Timestamptz(6)
  checkedItems  String[] @map("casillas")
  createdAt     DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Una aceptación por usuario y versión del aviso.
  @@unique([userId, policyVersion])
  @@index([userId])
  @@map("consentimiento_datos")
}

// ---------- Estructura académica ----------

model EducationLevel {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @map("nombre") @db.VarChar(60)
  sortOrder Int      @map("orden") @db.SmallInt
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  grades           Grade[]
  areaLevels       AreaLevel[]
  sharedActivities SharedActivity[]

  @@map("nivel")
}

model Grade {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  levelId       String   @map("nivel_id") @db.Uuid
  name          String   @unique @map("nombre") @db.VarChar(40)
  sortOrder     Int      @map("orden") @db.SmallInt
  active        Boolean  @default(true) @map("activo")
  coordinatorId String?  @map("coordinador_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  level                EducationLevel        @relation(fields: [levelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  coordinator          User?                 @relation(fields: [coordinatorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groups               Group[]
  lessonPlans          LessonPlan[]
  fieldJournalArchives FieldJournalArchive[]
  observerNotes        ObserverNote[]
  sharedActivities     SharedActivity[]

  // «A lo sumo una coordinadora por grado» queda garantizado por construcción (columna en el grado).
  @@index([levelId])
  @@index([coordinatorId])
  @@map("grado")
}

// Grupo de un grado (p. ej. «Kinder 3»): catálogo estable sin año lectivo; lo anual (docentes y
// director de grupo) vive en la asignación. El grado de un grupo no se edita.
model Group {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gradeId   String   @map("grado_id") @db.Uuid
  name      String   @map("nombre") @db.VarChar(40)
  active    Boolean  @default(true) @map("activo")
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  grade              Grade               @relation(fields: [gradeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacherAssignments TeacherAssignment[]
  fieldJournals      FieldJournal[]

  @@unique([gradeId, name])
  @@index([gradeId])
  @@map("grupo")
}

model Area {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @map("nombre") @db.VarChar(80)
  type      String   @map("tipo") @db.VarChar(12)
  active    Boolean  @default(true) @map("activa")
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  teacherAssignments      TeacherAssignment[]
  lessonPlanAreas         LessonPlanArea[]
  sharedActivities        SharedActivity[]
  trainingPlans           TrainingPlan[]
  areaLevels              AreaLevel[]
  fieldJournalAnnotations FieldJournalAnnotation[]

  @@map("area")
}

// Niveles a los que pertenece un área: define qué áreas se ofrecen al asignar y al planear.
model AreaLevel {
  areaId    String   @map("area_id") @db.Uuid
  levelId   String   @map("nivel_id") @db.Uuid
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  area  Area           @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  level EducationLevel @relation(fields: [levelId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([areaId, levelId])
  @@index([levelId])
  @@map("area_nivel")
}

// Año lectivo registrado por administración. isCurrent es true en el año vigente y NULL
// en los demás: el UNIQUE admite muchos NULL y un solo true, así que hay a lo sumo un vigente.
// Periodos y asignaciones lo referencian por code (FK sobre el texto AAAA-AAAA). La
// migración añade los CHECK del formato del código y de vigente.
model SchoolYear {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @map("codigo") @db.VarChar(9)
  isCurrent Boolean? @unique @map("vigente")
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  academicPeriods    AcademicPeriod[]
  teacherAssignments TeacherAssignment[]
  fieldJournals      FieldJournal[]

  @@map("anio_lectivo")
}

model AcademicPeriod {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolYear String    @map("anio_lectivo") @db.VarChar(9)
  number     Int       @map("numero") @db.SmallInt
  startDate  DateTime? @map("fecha_inicio") @db.Date
  endDate    DateTime? @map("fecha_fin") @db.Date
  createdAt  DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  schoolYearRef        SchoolYear            @relation(fields: [schoolYear], references: [code], onDelete: NoAction, onUpdate: NoAction)
  lessonPlans          LessonPlan[]
  fieldJournalArchives FieldJournalArchive[]

  @@unique([schoolYear, number])
  @@map("periodo_academico")
}

model TeacherAssignment {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId         String   @map("docente_id") @db.Uuid
  groupId           String   @map("grupo_id") @db.Uuid
  areaId            String   @map("area_id") @db.Uuid
  schoolYear        String   @map("anio_lectivo") @db.VarChar(9)
  isHomeroomTeacher Boolean  @default(false) @map("es_director_grupo")
  status            String   @default("activa") @map("estado") @db.VarChar(10)
  createdAt         DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  schoolYearRef SchoolYear @relation(fields: [schoolYear], references: [code], onDelete: NoAction, onUpdate: NoAction)
  teacher       User       @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  group         Group      @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  area          Area       @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // La migración añade el índice único parcial asignacion_docente_director_grupo_unico
  // (grupo_id, anio_lectivo) WHERE es_director_grupo AND estado = 'activa': un director por grupo y año.
  @@unique([teacherId, groupId, areaId, schoolYear])
  @@index([teacherId])
  @@index([groupId])
  @@index([areaId])
  @@map("asignacion_docente")
}

// ---------- Planeación ----------

model LessonPlan {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId             String    @map("docente_id") @db.Uuid
  gradeId               String    @map("grado_id") @db.Uuid
  periodId              String    @map("periodo_id") @db.Uuid
  dateFrom              DateTime? @map("fecha_desde") @db.Date
  dateTo                DateTime? @map("fecha_hasta") @db.Date
  topic                 String?   @map("tema") @db.VarChar(160)
  crossCuttingProject   String?   @map("proyecto_transversal") @db.VarChar(60)
  expectedPerformance   String?   @map("desempeno_esperado") @db.Text
  learningCorner        String?   @map("rincon") @db.VarChar(60)
  curiocityStage        String?   @map("etapa_curiocity") @db.VarChar(20)
  explorationMoment     String?   @map("momento_exploracion") @db.Text
  developmentMoment     String?   @map("momento_desarrollo") @db.Text
  socializationMoment   String?   @map("momento_socializacion") @db.Text
  closingMoment         String?   @map("momento_cierre") @db.Text
  resources             String?   @map("recursos") @db.Text
  reasonableAdjustments String?   @map("ajustes_razonables") @db.Text
  status                String    @map("estado") @db.VarChar(14)
  submittedAt           DateTime? @map("enviada_en") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  teacher         User                 @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grade           Grade                @relation(fields: [gradeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  period          AcademicPeriod       @relation(fields: [periodId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  linkedResources LessonPlanResource[]
  areas           LessonPlanArea[]

  @@index([teacherId])
  @@index([gradeId])
  @@index([periodId])
  @@map("planeacion")
}

// Áreas (dimensiones o asignaturas) de una planeación: una o más. La llave compuesta impide
// repetidas; «al menos una» lo garantiza el servicio (un CHECK no mira otra tabla).
model LessonPlanArea {
  lessonPlanId String   @map("planeacion_id") @db.Uuid
  areaId       String   @map("area_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  lessonPlan LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  area       Area       @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([lessonPlanId, areaId])
  @@index([areaId])
  @@map("planeacion_area")
}

model LessonPlanResource {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonPlanId String   @map("planeacion_id") @db.Uuid
  tool         String   @map("herramienta") @db.VarChar(20)
  name         String?  @map("nombre") @db.VarChar(120)
  url          String   @db.Text
  moment       Int?     @map("momento") @db.SmallInt
  createdAt    DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  lessonPlan LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([lessonPlanId])
  @@map("recurso_planeacion")
}

// Registro polimórfico: registro_id apunta a una planeación, un diario o una
// anotación según tipo_registro, por eso no tiene llave foránea.
model Review {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordType     String   @map("tipo_registro") @db.VarChar(12)
  recordId       String   @map("registro_id") @db.Uuid
  reviewerId     String   @map("revisor_id") @db.Uuid
  action         String   @map("accion") @db.VarChar(14)
  comment        String?  @map("comentario") @db.Text
  adjustedFields String[] @map("campos_ajustados")
  // Valores anterior y nuevo de los campos ajustados: { columna: { antes, despues } }.
  changes        Json?    @map("cambios") @db.JsonB
  date           DateTime @map("fecha") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  reviewer     User                      @relation(fields: [reviewerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  observations FieldJournalObservation[]

  @@index([reviewerId])
  @@index([recordType, recordId])
  @@map("revision")
}

model SharedActivity {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId        String   @map("autor_id") @db.Uuid
  levelId         String?  @map("nivel_id") @db.Uuid
  areaId          String?  @map("area_id") @db.Uuid
  gradeId         String?  @map("grado_id") @db.Uuid
  learningCorner  String?  @map("rincon") @db.VarChar(60)
  activityType    String   @default("actividad") @map("tipo") @db.VarChar(20)
  title           String   @map("titulo") @db.VarChar(160)
  objective       String?  @map("objetivo") @db.Text
  durationMinutes Int?     @map("duracion_min") @db.SmallInt
  materials       String?  @map("materiales") @db.Text
  steps           String   @map("pasos") @db.Text
  link            String?  @map("enlace") @db.Text
  createdAt       DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  author    User               @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  level     EducationLevel?    @relation(fields: [levelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  area      Area?              @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grade     Grade?             @relation(fields: [gradeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  favorites FavoriteActivity[]

  @@index([authorId])
  @@index([levelId])
  @@index([areaId])
  @@index([gradeId])
  @@map("actividad_repositorio")
}

model FavoriteActivity {
  userId     String @map("usuario_id") @db.Uuid
  activityId String @map("actividad_id") @db.Uuid

  user     User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  activity SharedActivity @relation(fields: [activityId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, activityId])
  @@map("favorito_actividad")
}

// ---------- Formatos ----------

// Diarios por docente y periodo anteriores a la épica #102 (diario colaborativo): solo lectura
// para la aplicación (la migración revoca INSERT, UPDATE y DELETE) y sin API ni pantalla.
model FieldJournalArchive {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId   String    @map("docente_id") @db.Uuid
  gradeId     String    @map("grado_id") @db.Uuid
  periodId    String    @map("periodo_id") @db.Uuid
  status      String    @map("estado") @db.VarChar(14)
  submittedAt DateTime? @map("enviada_en") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  teacher User                       @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grade   Grade                      @relation(fields: [gradeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  period  AcademicPeriod             @relation(fields: [periodId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entries FieldJournalArchiveEntry[]

  @@unique([teacherId, gradeId, periodId])
  @@index([teacherId])
  @@index([gradeId])
  @@index([periodId])
  @@map("diario_campo_historico")
}

model FieldJournalArchiveEntry {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journalId    String   @map("diario_id") @db.Uuid
  date         DateTime @map("fecha") @db.Date
  lesson       String?  @map("clase") @db.VarChar(80)
  eventType    String   @map("tipo_evento") @db.VarChar(10)
  // Privacidad: solo nombres de pila, sin otros datos de los estudiantes.
  studentNames String?  @map("estudiantes") @db.VarChar(160)
  description  String   @map("descripcion") @db.Text
  actions      String?  @map("acciones") @db.Text
  reflection   String?  @map("reflexion") @db.Text
  createdAt    DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  journal FieldJournalArchive @relation(fields: [journalId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([journalId])
  @@map("diario_entrada_historico")
}

// Diario de campo F-PA-05 de un grupo en una fecha (colaborativo: cada docente del grupo aporta
// anotaciones y el director o la directora de grupo lo envía a coordinación).
model FieldJournal {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId     String    @map("grupo_id") @db.Uuid
  date        DateTime  @map("fecha") @db.Date
  // Año lectivo con que se creó: fija qué asignaciones cuentan como participantes.
  schoolYear  String    @map("anio_lectivo") @db.VarChar(9)
  status      String    @map("estado") @db.VarChar(14)
  createdById String    @map("creado_por") @db.Uuid
  submittedAt DateTime? @map("enviado_en") @db.Timestamptz(6)
  voidedAt    DateTime? @map("anulado_en") @db.Timestamptz(6)
  voidedById  String?   @map("anulado_por") @db.Uuid
  createdAt   DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  group         Group                    @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schoolYearRef SchoolYear               @relation(fields: [schoolYear], references: [code], onDelete: NoAction, onUpdate: NoAction)
  createdBy     User                     @relation("FieldJournalCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  voidedBy      User?                    @relation("FieldJournalVoidedBy", fields: [voidedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  annotations   FieldJournalAnnotation[]
  submissions   FieldJournalSubmission[]

  @@unique([groupId, date])
  @@index([groupId])
  @@index([date])
  @@index([status])
  @@map("diario_campo")
}

// Aporte de un docente al diario. `sent` indica que viajó en algún envío (false tras un envío
// = «No enviada»).
model FieldJournalAnnotation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journalId   String    @map("diario_id") @db.Uuid
  teacherId   String    @map("docente_id") @db.Uuid
  areaId      String    @map("area_id") @db.Uuid
  // Privacidad: texto libre solo con nombres de pila de los estudiantes.
  description String    @map("descripcion") @db.Text
  status      String    @map("estado") @db.VarChar(10)
  readyAt     DateTime? @map("lista_en") @db.Timestamptz(6)
  sent        Boolean   @default(false) @map("enviada")
  createdAt   DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  journal      FieldJournal              @relation(fields: [journalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher      User                      @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  area         Area                      @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  observations FieldJournalObservation[]

  @@index([journalId])
  @@index([teacherId])
  @@index([areaId])
  @@map("diario_anotacion")
}

// Un envío (o reenvío) del director de grupo, con el resumen de aportes de ese momento.
model FieldJournalSubmission {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journalId     String   @map("diario_id") @db.Uuid
  directorId    String   @map("director_id") @db.Uuid
  submittedAt   DateTime @map("enviado_en") @db.Timestamptz(6)
  resubmission  Boolean  @map("reenvio")
  readyCount    Int      @map("aportes_listos") @db.SmallInt
  expectedCount Int      @map("docentes_esperados") @db.SmallInt
  // [{ docenteId, estado: 'borrador' | 'sin_aporte' }]; nunca textos.
  missing       Json     @map("faltantes") @db.JsonB
  createdAt     DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  journal  FieldJournal @relation(fields: [journalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  director User         @relation(fields: [directorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([journalId])
  @@index([directorId])
  @@map("diario_envio")
}

// Observación de coordinación sobre una anotación; cuelga de la decisión (`revision`). La
// observación general es el comentario de esa decisión.
model FieldJournalObservation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId     String   @map("revision_id") @db.Uuid
  annotationId String   @map("anotacion_id") @db.Uuid
  text         String   @map("texto") @db.Text
  createdAt    DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  review     Review                 @relation(fields: [reviewId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  annotation FieldJournalAnnotation @relation(fields: [annotationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([reviewId])
  @@index([annotationId])
  @@map("diario_observacion")
}

model ObserverNote {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId             String   @map("docente_id") @db.Uuid
  gradeId               String   @map("grado_id") @db.Uuid
  // Privacidad: solo el nombre de pila del estudiante, sin datos sensibles.
  studentFirstName      String   @map("estudiante_nombre") @db.VarChar(40)
  date                  DateTime @map("fecha") @db.Date
  type                  String   @map("tipo") @db.VarChar(12)
  description           String   @map("descripcion") @db.Text
  studentVersion        String?  @map("version_estudiante") @db.Text
  pedagogicalStrategies String?  @map("estrategias_pedagogicas") @db.Text
  actions               String?  @map("acciones") @db.Text
  familyInformed        Boolean  @default(false) @map("familia_informada")
  followUp              String?  @map("seguimiento") @db.Text
  status                String   @map("estado") @db.VarChar(14)
  createdAt             DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  teacher User  @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grade   Grade @relation(fields: [gradeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([teacherId])
  @@index([gradeId])
  @@map("observador_anotacion")
}

// ---------- Plan de formación ----------

model TrainingPlan {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Vacío = plan General para todos los docentes.
  areaId     String?  @map("area_id") @db.Uuid
  name       String   @map("nombre") @db.VarChar(120)
  schoolYear String?  @map("anio_lectivo") @db.VarChar(9)
  createdAt  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  area     Area?             @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  modules  TrainingModule[]
  sections TrainingSection[]

  @@index([areaId])
  @@map("plan_formacion")
}

// Sección de un plan (p. ej. «Parte I»): agrupa módulos y se ordena dentro del plan.
// Sin estado: una sección sin módulos activos no aparece en la ruta del docente.
model TrainingSection {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  title     String   @map("titulo") @db.VarChar(120)
  subtitle  String?  @map("subtitulo") @db.VarChar(200)
  sortOrder Int      @map("orden") @db.SmallInt
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  plan    TrainingPlan     @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  modules TrainingModule[]

  // Respalda la llave foránea compuesta de `modulo_formacion` (la sección es del mismo plan).
  @@unique([id, planId])
  @@index([planId])
  @@map("seccion_plan")
}

// `status` admite `borrador` (módulo aún no publicado, sin progreso) además de
// `activo` y `fuera_del_plan`; el CHECK vive en la migración.
model TrainingModule {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId             String   @map("plan_id") @db.Uuid
  sectionId          String   @map("seccion_id") @db.Uuid
  number             String?  @map("numero") @db.VarChar(4)
  sortOrder          Int      @map("orden") @db.SmallInt
  title              String   @map("titulo") @db.VarChar(160)
  summary            String?  @map("resumen") @db.Text
  videoUrl           String?  @map("video_url") @db.Text
  videoTitle         String?  @map("video_titulo") @db.VarChar(160)
  presentationUrl    String?  @map("presentacion_url") @db.Text
  // Video y presentación como archivo subido; excluyen al enlace del mismo propósito (CHECK).
  videoFileId        String?  @map("video_archivo_id") @db.Uuid
  presentationFileId String?  @map("presentacion_archivo_id") @db.Uuid
  status             String   @map("estado") @db.VarChar(14)
  // Desafío GNS: porcentaje para aprobar y tiempo fijo por pregunta (nulo = tiempo vigente por tipo).
  approvalThreshold  Int      @default(80) @map("umbral_aprobacion") @db.SmallInt
  secondsPerQuestion Int?     @map("segundos_por_pregunta") @db.SmallInt
  createdAt          DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  plan             TrainingPlan        @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  section          TrainingSection     @relation(fields: [sectionId, planId], references: [id, planId], onDelete: NoAction, onUpdate: NoAction)
  videoFile        StoredFile?         @relation("ModuleVideoFile", fields: [videoFileId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  presentationFile StoredFile?         @relation("ModulePresentationFile", fields: [presentationFileId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  slides           Slide[]
  questions        ChallengeQuestion[]
  progress         ModuleProgress[]
  certificates     Certificate[]
  activities       TrainingActivity[]

  @@index([planId])
  @@index([sectionId])
  @@index([videoFileId])
  @@index([presentationFileId])
  @@map("modulo_formacion")
}

model Slide {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId  String   @map("modulo_id") @db.Uuid
  sortOrder Int      @map("orden") @db.SmallInt
  title     String?  @map("titulo") @db.VarChar(160)
  keyIdeas  String?  @map("ideas_clave") @db.Text
  createdAt DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  module TrainingModule @relation(fields: [moduleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([moduleId])
  @@map("diapositiva")
}

model ChallengeQuestion {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId        String   @map("modulo_id") @db.Uuid
  sortOrder       Int      @map("orden") @db.SmallInt
  type            String   @map("tipo") @db.VarChar(8)
  prompt          String   @map("enunciado") @db.Text
  feedback        String?  @map("retroalimentacion") @db.Text
  trueFalseAnswer Boolean? @map("respuesta_vf")
  createdAt       DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  module  TrainingModule   @relation(fields: [moduleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  options QuestionOption[]

  @@index([moduleId])
  @@map("pregunta_desafio")
}

model QuestionOption {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId      String   @map("pregunta_id") @db.Uuid
  text            String   @map("texto") @db.VarChar(200)
  isCorrect       Boolean? @map("es_correcta")
  correctPosition Int?     @map("orden_correcto") @db.SmallInt
  createdAt       DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  question ChallengeQuestion @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([questionId])
  @@map("opcion_pregunta")
}

model ModuleProgress {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId            String    @map("docente_id") @db.Uuid
  moduleId             String    @map("modulo_id") @db.Uuid
  videoViewedAt        DateTime? @map("video_visto_en") @db.Timestamptz(6)
  presentationViewedAt DateTime? @map("presentacion_vista_en") @db.Timestamptz(6)
  bestScore            Int?      @map("mejor_puntaje") @db.SmallInt
  passedAt             DateTime? @map("aprobado_en") @db.Timestamptz(6)
  completedAt          DateTime? @map("terminado_en") @db.Timestamptz(6)
  // Partida del Desafío en curso (estado del servidor, nunca sale de la API); NULL si no hay.
  challengeGame        Json?     @map("partida_desafio") @db.JsonB
  createdAt            DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  teacher  User               @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  module   TrainingModule     @relation(fields: [moduleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attempts ChallengeAttempt[]

  @@unique([teacherId, moduleId])
  @@index([teacherId])
  @@index([moduleId])
  @@map("progreso_modulo")
}

model ChallengeAttempt {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  progressId String   @map("progreso_id") @db.Uuid
  score      Int      @map("puntaje") @db.SmallInt
  points     Int      @map("puntos")
  date       DateTime @map("fecha") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  progress ModuleProgress @relation(fields: [progressId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([progressId])
  @@map("intento_desafio")
}

model Certificate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId   String   @map("docente_id") @db.Uuid
  // Vacío = certificado de la ruta completa.
  moduleId    String?  @map("modulo_id") @db.Uuid
  code        String   @unique @map("codigo") @db.VarChar(20)
  issuedAt    DateTime @map("emitido_en") @db.Timestamptz(6)
  // PDF guardado en el almacenamiento; nulo hasta la primera descarga.
  fileId      String?  @map("archivo_id") @db.Uuid
  // Instantánea de la emisión: no cambia si el docente o el módulo se renombran después.
  teacherName String   @map("nombre_docente") @db.VarChar(120)
  title       String   @map("titulo") @db.VarChar(160)
  planName    String?  @map("plan_nombre") @db.VarChar(120)
  createdAt   DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  teacher User            @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  module  TrainingModule? @relation(fields: [moduleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  file    StoredFile?     @relation(fields: [fileId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // La migración añade dos índices únicos parciales (un certificado por docente y módulo, y uno
  // de ruta completa por docente) y el rol de la aplicación no tiene DELETE.
  @@index([teacherId])
  @@index([moduleId])
  @@index([fileId])
  @@map("certificado")
}

// Actividad configurable de un módulo. `configuracion` es JSON validado con los
// esquemas Zod de @gns/shared según `tipo`; la base solo exige un objeto.
// Un módulo termina cuando se completan todas las actividades obligatorias activas.
model TrainingActivity {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId     String   @map("modulo_id") @db.Uuid
  type         String   @map("tipo") @db.VarChar(16)
  sortOrder    Int      @map("orden") @db.SmallInt
  title        String   @map("titulo") @db.VarChar(160)
  isRequired   Boolean  @map("obligatoria")
  instructions String?  @map("instrucciones") @db.VarChar(500)
  status       String   @map("estado") @db.VarChar(14)
  config       Json     @map("configuracion") @db.JsonB
  createdAt    DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  module   TrainingModule     @relation(fields: [moduleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  progress ActivityProgress[]

  @@index([moduleId])
  @@map("actividad_modulo")
}

// Progreso de un docente en una actividad. `completedAt` no nulo = completada.
model ActivityProgress {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId   String    @map("docente_id") @db.Uuid
  activityId  String    @map("actividad_id") @db.Uuid
  completedAt DateTime? @map("completada_en") @db.Timestamptz(6)
  bestScore   Int?      @map("mejor_puntaje") @db.SmallInt
  bestPoints  Int?      @map("mejores_puntos")
  attempts    Int       @default(0) @map("intentos") @db.SmallInt
  detail      Json?     @map("detalle") @db.JsonB
  // Partida de conecta o verdad o mito en curso (estado del servidor); NULL si no hay.
  game        Json?     @map("partida") @db.JsonB
  createdAt   DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  teacher  User             @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  activity TrainingActivity @relation(fields: [activityId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([teacherId, activityId])
  @@index([teacherId])
  @@index([activityId])
  @@map("progreso_actividad")
}

// ---------- Asistente ----------

model FaqEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category    String   @map("categoria") @db.VarChar(40)
  question    String   @map("pregunta") @db.VarChar(200)
  answer      String   @map("respuesta") @db.Text
  keywords    String?  @map("palabras_clave") @db.Text
  source      String?  @map("fuente") @db.VarChar(120)
  isActive    Boolean  @default(false) @map("activa")
  updatedById String?  @map("actualizado_por") @db.Uuid
  createdAt   DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  updatedBy           User?                @relation(fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unansweredQuestions UnansweredQuestion[]

  @@index([updatedById])
  @@map("pregunta_frecuente")
}

// Pregunta que el asistente no supo responder, agrupada por su texto normalizado: una fila
// pendiente por texto (índice único parcial de la migración assistant_search). Al cerrarse
// (atendida o descartada) `text` y `normalizedText` pasan a NULL: el texto puede nombrar a
// menores y deja de hacer falta, pero se conservan las ocurrencias, los contadores y el cierre.
// La migración añade los CHECK de coherencia entre estado, texto, cierre y enlace.
model UnansweredQuestion {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  text           String?   @map("texto") @db.VarChar(200)
  normalizedText String?   @map("texto_normalizado") @db.VarChar(200)
  times          Int       @default(1) @map("veces")
  firstAskedAt   DateTime  @default(now()) @map("primera_vez") @db.Timestamptz(6)
  lastAskedAt    DateTime  @default(now()) @map("ultima_vez") @db.Timestamptz(6)
  status         String    @default("pendiente") @map("estado") @db.VarChar(12)
  faqId          String?   @map("pregunta_frecuente_id") @db.Uuid
  closedById     String?   @map("cerrada_por") @db.Uuid
  closedAt       DateTime? @map("cerrada_en") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  faq         FaqEntry?                      @relation(fields: [faqId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  closedBy    User?                          @relation("UnansweredQuestionClosedBy", fields: [closedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  occurrences UnansweredQuestionOccurrence[]

  @@index([faqId])
  @@index([closedById])
  @@index([status])
  @@map("pregunta_sin_respuesta")
}

// Cada vez que alguien hace una pregunta sin respuesta: quién y cuándo, nunca el texto. Solo
// inserción para la aplicación (la migración revoca UPDATE y DELETE a `app_gns`).
model UnansweredQuestionOccurrence {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unansweredQuestionId String   @map("pregunta_sin_respuesta_id") @db.Uuid
  userId               String   @map("usuario_id") @db.Uuid
  askedAt              DateTime @default(now()) @map("preguntado_en") @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  unansweredQuestion UnansweredQuestion @relation(fields: [unansweredQuestionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user               User               @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([unansweredQuestionId, askedAt(sort: Desc)])
  @@index([userId])
  @@map("ocurrencia_pregunta_sin_respuesta")
}

// ---------- Auditoría ----------

// Solo inserción: los triggers de la migración immutable_audit_log rechazan
// UPDATE, DELETE y TRUNCATE. El id es GENERATED ALWAYS AS IDENTITY en la
// migración init_schema (Prisma solo expresa autoincrement()).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  occurredAt DateTime @default(now()) @map("fecha_hora") @db.Timestamptz(6)
  // Opcional: ingresos fallidos y acciones del sistema no tienen usuario.
  userId     String?  @map("usuario_id") @db.Uuid
  role       String   @map("rol") @db.VarChar(20)
  type       String   @map("tipo") @db.VarChar(20)
  action     String   @map("accion") @db.VarChar(160)
  entity     String?  @map("entidad") @db.VarChar(40)
  entityId   String?  @map("entidad_id") @db.Uuid
  detail     String?  @map("detalle") @db.Text
  dataBefore Json?    @map("datos_antes") @db.JsonB
  dataAfter  Json?    @map("datos_despues") @db.JsonB

  user User? @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@map("bitacora")
}

// Metadatos y estado de cada objeto del almacenamiento (video y presentación de módulos,
// PDF de certificados). El rol de la aplicación no tiene DELETE; la migración añade los CHECK
// de `proposito`, `estado` y `tamano_bytes > 0`.
model StoredFile {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectKey    String    @unique @map("clave_objeto") @db.VarChar(200)
  purpose      String    @map("proposito") @db.VarChar(20)
  contentType  String    @map("tipo_contenido") @db.VarChar(100)
  sizeBytes    BigInt    @map("tamano_bytes")
  originalName String?   @map("nombre_original") @db.VarChar(160)
  status       String    @map("estado") @db.VarChar(12)
  uploadedById String?   @map("subido_por") @db.Uuid
  confirmedAt  DateTime? @map("confirmado_en") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  uploadedBy            User?            @relation(fields: [uploadedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  videoOfModules        TrainingModule[] @relation("ModuleVideoFile")
  presentationOfModules TrainingModule[] @relation("ModulePresentationFile")
  certificates          Certificate[]

  @@index([uploadedById])
  @@map("archivo")
}
