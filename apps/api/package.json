{
  "name": "@gns/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:db": "jest -c jest.db.config.json --runInBand",
    "test:e2e": "jest -c jest.e2e.config.json --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check": "prisma validate && prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:seed": "prisma db seed",
    "db:demo:load": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env prisma/seed/run-demo-load.ts",
    "storage:init": "node --env-file-if-exists=.env dist/cli/init-storage.js",
    "admin:init-password": "node --env-file-if-exists=.env dist/cli/init-admin-password.js",
    "db:demo:clear": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env prisma/seed/run-demo-clear.ts",
    "typecheck:seed": "tsc -p prisma/tsconfig.json && tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@aws-sdk/s3-request-presigner": "3.1155.0",
    "@gns/shared": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.5.0",
    "pdfkit": "0.20.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@testcontainers/postgresql": "12.2.1",
    "@types/cookie-parser": "1.4.10",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "testcontainers": "12.2.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
