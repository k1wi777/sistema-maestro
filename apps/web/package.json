{
  "name": "@gns/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "api:types": "openapi-typescript src/shared/api/openapi.json -o src/shared/api/generated/schema.ts",
    "predev": "pnpm api:types",
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev -p 3001",
    "prebuild": "pnpm api:types",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 next start -p 3001",
    "pretypecheck": "pnpm api:types",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@gns/shared": "workspace:*",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "jest": "30.5.2",
    "openapi-typescript": "7.13.0",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
