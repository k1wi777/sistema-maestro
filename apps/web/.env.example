# Dirección de la API (sin barra final). Copia este archivo a apps/web/.env.local.
# Usa siempre `localhost`, no `127.0.0.1`: es otro origen para CORS y otro site para las cookies.
NEXT_PUBLIC_API_URL=http://localhost:3000

# URL pública del frontend (opcional, sin barra final): sirve para la vista previa de enlaces
# (Open Graph). Si falta se usa http://localhost:3001. En producción, la URL pública de la web.
# NEXT_PUBLIC_SITE_URL=http://localhost:3001
